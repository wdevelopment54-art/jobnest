# Flask
SECRET_KEY=change-me-to-a-random-secret-string

# Database (SQLite by default - no server needed; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///job_portal.db

# Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_UPLOAD_MB=5

# Mail (used for password reset & notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@jobportal.com

# Pagination
PER_PAGE=9

# Job publishing behaviour
# If True, employer jobs are published immediately (Active).
# If False, jobs require admin approval (Pending Approval).
AUTO_PUBLISH_JOBS=False

# Flask environment
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Site / business contact info
SITE_NAME=JOBNEST
SITE_EMAIL=info@yourjobportal.com
SITE_PHONE_DISPLAY=0309-6890020
SITE_PHONE_HREF=tel:03096890020
SITE_WHATSAPP_NUMBER=0309-6890020
SITE_WHATSAPP_HREF=https://wa.me/923096890020
SITE_WHATSAPP_MESSAGE=Hello, I would like to know more about your Job Portal services.
SITE_CITY=Kot Radha Kishen
SITE_STATE=Punjab
SITE_COUNTRY=Pakistan
SITE_ADDRESS=Kot Radha Kishen, Punjab, Pakistan
SITE_MAP_URL=https://www.google.com/maps/search/?api=1&query=Kot+Radha+Kishen+Punjab+Pakistan
SITE_FACEBOOK_URL=#
SITE_TWITTER_URL=#
SITE_LINKEDIN_URL=#
SITE_INSTAGRAM_URL=#
